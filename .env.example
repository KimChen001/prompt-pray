# Copy to .env.local. The app runs fully offline without any of these.
# AI. Without AI_API_KEY every AI feature shows the offline/template text.
# Provider: openai-compatible (default; MIT Parley) | openai | anthropic. Each provider has its own
# adapter and parameters (see src/lib/ai/capabilities.ts); switching is more than changing a URL.
AI_PROVIDER=openai-compatible
AI_API_KEY=
# Optional overrides. Defaults: Parley https://parley.api.mit.edu/v1 + claude-haiku-4-5;
# anthropic → claude-opus-5-5; openai → no default model (set the one you pay for).
AI_BASE_URL=
AI_MODEL=
# Anthropic only: server-side refusal fallback is on by default; set to "off" to disable.
AI_FALLBACKS=
# Spend caps (persisted in .data/ai-usage.json). Defaults: 300 calls/day, $5/day, $25 total.
AI_MAX_CALLS_PER_DAY=
AI_MAX_USD_PER_DAY=
AI_MAX_USD_TOTAL=
# Prices in USD per million tokens for the cap estimate (defaults come from a table).
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
# Optional. When set, only browsers that entered this code on the Me page can use AI.
# Use it on any public deployment.
AI_ACCESS_CODE=
# Supabase (community + share snapshots, from 10/10)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
