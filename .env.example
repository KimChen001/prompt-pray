# Copy to .env.local. The app runs fully offline without any of these.
# AI: any OpenAI-compatible endpoint. Defaults target MIT Parley (https://platform.parley.mit.edu).
# Without AI_API_KEY every AI feature falls back to the offline/template text.
AI_API_KEY=
AI_BASE_URL=https://parley.api.mit.edu/v1
AI_MODEL=claude-haiku-4-5
# Optional. When set, only browsers that entered this code on the Me page can use AI
# (use this on any public deployment until the provider's terms allow public use).
AI_ACCESS_CODE=
# Supabase (community + share snapshots, from 10/10)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
