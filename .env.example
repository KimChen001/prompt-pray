# Copy to .env.local. The app runs fully offline without any of these.
# AI. Without AI_API_KEY every AI feature shows the offline/template text.
# Provider: openai-compatible (default; MIT Parley) | openai | anthropic. Each provider has its own
# adapter and parameters (see src/lib/ai/capabilities.ts); switching is more than changing a URL.
AI_PROVIDER=openai-compatible
AI_API_KEY=
# Optional overrides. Defaults: Parley https://parley.api.mit.edu/v1 + claude-haiku-4-5;
# anthropic → claude-opus-5-5; openai → no default model (set the one you pay for).
AI_BASE_URL=
AI_MODEL=
# Anthropic only: server-side refusal fallback is on by default; set to "off" to disable.
AI_FALLBACKS=
# Spend caps (persisted in .data/ai-usage.json). Defaults: 300 calls/day, $5/day, $25 total.
AI_MAX_CALLS_PER_DAY=
AI_MAX_USD_PER_DAY=
AI_MAX_USD_TOTAL=
# Prices in USD per million tokens for the cap estimate (defaults come from a table).
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
# Optional. When set, only browsers that entered this code in Journal → Settings can use AI.
# Use it on any public deployment.
AI_ACCESS_CODE=
# Signs the pseudonymous visitor cookie that AI limits are counted by (not per IP: a room on one
# school Wi-Fi shares an address). At least 32 characters; generate it yourself, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# and set it in the host's environment. Never paste it into chat. Required on any deployment (AI
# stays off without it); locally a fixed development key is used.
SESSION_SECRET=
# The shared budget ledger (docs/ai-ledger-spec.md). On Vercel AI stays off without DATABASE_URL:
# a per-instance ledger is not a spending cap. Use the Supabase transaction pooler (port 6543) with
# the limited moona_app role; the owner URL is for scripts only and never goes on Vercel.
DATABASE_URL=
# auto (Postgres when DATABASE_URL is set, else the local JSON file) | postgres | pglite | memory | file
MOONA_LEDGER=
# dev | event-2026-10-28 (the $100 Demo Day plan: AI $50 = testing $10 + Demo Day $35 + after $5)
MOONA_PLAN=
# Offline rehearsal without a key or any spend: AI_PROVIDER=fake (shown as "Simulated", never live AI).
# Public HTTPS address of the deployed site, used for the "Try it on your phone" QR code on the
# desktop home page. Without it the page's own address is used and labelled as a test address.
# The QR code only ever contains this site root (no questions, records, keys or access codes).
NEXT_PUBLIC_SITE_URL=
# Supabase (planned: shared Whispers wall, revocable share links, remote match invites).
# Not used by the current build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
